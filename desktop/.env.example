# Copy to .env and fill in. The orchestrator uses OpenAI when a key is
# present; without it, Alakeya runs the built-in offline planner.
OPENAI_API_KEY=
# Optional — defaults to gpt-4o (средняя модель). Дешевле: gpt-4o-mini
ALAKEYA_MODEL=gpt-4o
# Set to 1 to enable REAL macOS control (open/osascript/AX). Default: simulate.
ALAKEYA_REAL_CONTROL=0
